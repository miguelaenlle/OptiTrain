# GPT-2 124M on OpenWebText — Karpathy's train_gpt2.py config, our hardware.
#
# Source this before a LONG run (the 1h / 4h / 36h baselines):
#     set -a && . recipes/gpt2-owt.env && set +a
#     NODES=8 TRAIN_BUDGET_SECONDS=129600 spot-orchestrate multinode
#
# For the short 1/2/4/8-node ladder use recipes/gpt2-owt-ladder.env instead —
# these settings spend the first 2000 steps in LR warmup, which a 15-minute run
# never escapes. See recipes/README.md.
#
# Every value below is verbatim from third_party/nanoGPT/config/train_gpt2.py
# plus that script's inherited train.py defaults. The ONLY difference from
# Karpathy is hardware: he ran 8xA100-40GB in one box; we run N x g5.xlarge
# (1x A10G 24GB each) across nodes. Gradient accumulation absorbs the
# difference, so the optimizer sees an identical 480-sequence global batch.

# --- model: GPT-2 124M ------------------------------------------------------
N_LAYER=12
N_HEAD=12
N_EMBD=768
BLOCK_SIZE=1024
DROPOUT=0.0

# --- batch: 480 seq x 1024 ctx = 491,520 tokens/step ------------------------
# Karpathy: batch_size 12 * 5 accum * 8 GPUs = 480 seq. We hold GLOBAL_BATCH_SIZE
# fixed and let the trainer recompute accum per world size (ceil(global/(world*
# micro))), so 1/2/4/8 nodes all take IDENTICAL optimizer steps — that step-match
# is what makes cross-node-count loss curves comparable.
#
# BATCH_SIZE is the PER-RANK micro-batch. It must divide 60, or the ceil() makes
# the effective global batch drift at some node counts and the control is broken.
# Safe: 12, 10, 6, 5, 4, 3, 2, 1.  NOT SAFE: 8 (-> 512 at 8 nodes), 16, 14, 9.
# If 12 OOMs on the 24GB A10G, step DOWN to 10, then 6 — never to 8.
GLOBAL_BATCH_SIZE=480
BATCH_SIZE=12

# --- optimizer / schedule ---------------------------------------------------
# betas (0.9, 0.95) are already hardcoded in train.py to match nanoGPT.
LEARNING_RATE=6e-4
MIN_LR=6e-5
WARMUP_STEPS=2000
WEIGHT_DECAY=0.1
GRAD_CLIP=1.0

# Karpathy decays over 600k steps (300B tokens, ~5 days on 8xA100). Our budget is
# ~36h, so we reach only a fraction of that and the LR would still be near max at
# the end — a fixed-budget run wants its cosine to LAND. Set LR_DECAY_STEPS to the
# step count you actually expect (calibrate prints a projection), or keep 600000
# for a schedule-faithful reproduction. Whichever you choose, use the SAME value
# for every run in a comparison, or the loss curves are not comparable.
LR_DECAY_STEPS=600000
MAX_STEPS=600000

# --- eval / logging ---------------------------------------------------------
EVAL_INTERVAL_STEPS=1000
EVAL_ITERS=200
LOG_INTERVAL_STEPS=10
SAMPLE_INTERVAL_STEPS=0

# --- hardware / data --------------------------------------------------------
DATASET=openwebtext
INSTANCE_TYPE=g5.xlarge
VCPU_QUOTA=64
