# GPT-2 124M / OpenWebText — SHORT-RUN variant for the 1/2/4/8-node ladder.
#
#     set -a && . recipes/gpt2-owt-ladder.env && set +a
#     NODE_COUNTS=1,2,4,8 TARGET_LOSS=<from calibrate> spot-orchestrate scaling-clean
#
# Same model, same 480-sequence global batch, same data and seed as
# recipes/gpt2-owt.env — so throughput numbers carry over directly. Only the
# SCHEDULE and EVAL CADENCE differ, because the ladder asks a different question:
# "how much faster does N nodes reach a fixed val loss?", answered in minutes,
# not days.
#
# Why the schedule must change for short runs: the canonical recipe warms up over
# 2000 steps and evals every 1000. A ladder run lasts ~10-25 min, which at 480x1024
# tokens/step is only a few hundred steps — it would end DURING warmup, having
# never run a single eval. Every run would report "target not reached" and the
# ladder would be uninformative. Short warmup + frequent eval fixes that.

# --- model: identical to the canonical recipe -------------------------------
N_LAYER=12
N_HEAD=12
N_EMBD=768
BLOCK_SIZE=1024
DROPOUT=0.0

# --- batch: identical (see gpt2-owt.env for the divides-60 rule) ------------
GLOBAL_BATCH_SIZE=480
BATCH_SIZE=12

# --- optimizer: same peak/floor LR, schedule compressed to the run ----------
LEARNING_RATE=6e-4
MIN_LR=6e-5
WARMUP_STEPS=100
LR_DECAY_STEPS=5000
WEIGHT_DECAY=0.1
GRAD_CLIP=1.0
MAX_STEPS=1000000

# --- eval: fine granularity so time-to-target has resolution ----------------
# The ladder's whole output is "when did val cross TARGET_LOSS", so eval cadence
# sets the measurement precision. EVAL_ITERS is cut from 200 to 40: a full 200-iter
# val pass every 25 steps would cost more wall-clock than the training it measures.
EVAL_INTERVAL_STEPS=25
EVAL_ITERS=40
LOG_INTERVAL_STEPS=10
SAMPLE_INTERVAL_STEPS=0

# --- hardware / data --------------------------------------------------------
DATASET=openwebtext
INSTANCE_TYPE=g5.xlarge
VCPU_QUOTA=64

# The 1-node run needs ~8x the 8-node wall-clock to reach the same loss, and the
# cap applies to EVERY run in the sweep — so size it off the SLOWEST run or the
# 1-node entry comes back INCONCLUSIVE and there is no baseline to divide by.
SCALING_CAP_SECONDS=10800
