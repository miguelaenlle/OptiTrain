# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Training artifacts
checkpoints/
*.ckpt
*.pt
*.pth
# Dataset bins are huge + regenerable — ignore them, but KEEP our prep scripts
# (data/<dataset>/prepare.py) tracked so `stage-data` can build the corpus.
data/**/*.bin
# ...and the in-progress artifacts of a long prep job (.bin.partial/.bin.progress)
data/**/*.bin.*
data/**/*.pkl
datasets/
out/
wandb/
*.log

# Inference fleet (local-mode state + loadgen artifacts)
.fleet/
loadgen/loadgen
loadgen-report.json

# Terraform
infra/terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl

# Go
supervisor/bin/
supervisor/*.out

# Secrets / local
.env
*.pem
credentials
.DS_Store
.idea/
.vscode/
reports/

# Local Gantt timeline exports written by `spot-orchestrate logs` (the `e` key)
*-timeline.png
*-events.txt

# Grafana: exported run data is regenerable from S3 artifacts
deploy/grafana/data/
# live-loop scratch: one dir per run, pulled from S3 each tick
deploy/grafana/.live/

# Grafana export artifacts (regenerate with export.py)
deploy/grafana/data/
